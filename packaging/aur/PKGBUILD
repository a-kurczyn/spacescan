# Maintainer: Alejandro Kurczyn <335237751+a-kurczyn@users.noreply.github.com>

pkgname=spacescan
pkgver=1.2.0
pkgrel=1
pkgdesc='Disk-usage explorer with a sunburst chart, a keyboard-driven table and reports'
arch=('x86_64')
url='https://github.com/a-kurczyn/spacescan'
license=('GPL-3.0-only')
# The display, input and D-Bus libraries are loaded at run time.
depends=(
  'dbus'
  'glibc'
  'hicolor-icon-theme'
  'libgcc'
  'libglvnd'
  'libx11'
  'libxcursor'
  'libxi'
  'libxkbcommon'
  'libxkbcommon-x11'
  'wayland'
)
makedepends=('cargo' 'git')
# The release build has no debug information to put in a debug package.
options=('!debug')
optdepends=('xdg-desktop-portal: folder picker')
source=("git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/spacescan "$pkgdir/usr/bin/spacescan"
  install -Dm644 packaging/spacescan.desktop "$pkgdir/usr/share/applications/spacescan.desktop"
  for size in 16 24 32 48 64 128 256; do
    install -Dm644 "packaging/icons/${size}x${size}/spacescan.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/spacescan.png"
  done
  install -Dm644 packaging/spacescan.1 "$pkgdir/usr/share/man/man1/spacescan.1"
  install -Dm644 packaging/io.github.a_kurczyn.spacescan.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.a_kurczyn.spacescan.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # The About window opens THIRD-PARTY-LICENSES.html from here; docs/ holds
  # the screenshots README.md shows.
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md CHANGELOG.md THIRD-PARTY-LICENSES.html
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname/docs" docs/*.png
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname/filemanagers" packaging/filemanagers/*
}
